# EasyCode configuration. Copy to .env and adjust.
# Every value here has a working default — the project runs with no .env at all.

# --- Vector store (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=easycode_chunks

# --- Graph store (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=easycode

# --- Application metadata ---
# SQLite by default; point at PostgreSQL for a deployment, e.g.
# DATABASE_URL=postgresql+psycopg://easycode:easycode@localhost:5432/easycode
DATABASE_URL=sqlite:///./data/easycode.db

# --- Embeddings (local, no API key needed) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# --- LLM ---
# "ollama" (local, the default), "openai" (any OpenAI-compatible endpoint),
# or "extractive" (no model at all — answers list retrieved locations).
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=180

# Optional hosted provider. Leave OPENAI_API_KEY empty to keep it disabled;
# EasyCode never requires a paid key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval ---
RETRIEVAL_VECTOR_LIMIT=20
RETRIEVAL_CONTEXT_LIMIT=12
RETRIEVAL_MAX_CONTEXT_CHARS=24000

# --- Ingestion ---
REPOS_DIR=./data/repos
MAX_FILE_BYTES=1000000
CLONE_DEPTH=1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
